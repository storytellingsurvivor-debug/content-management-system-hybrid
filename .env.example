# Copy this file to .env.local (or configure the same keys in your Netlify
# site's environment variables) and fill in real values. Never commit the
# filled-in file — .gitignore already excludes .env* except this example.

# --- CMS webhooks (src/app/api/webhooks/babylovegrowth/**) ---
# Supabase project used for the "happy" prod/staging webhook routes.
# Service role key — server-side only, full write access, never expose to the browser.
SUPABASE_URL_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=
SUPABASE_URL_STAGING=
SUPABASE_SERVICE_ROLE_KEY_STAGING=

# --- Twitch bot (/twitch, /session/[token], src/app/api/twitch/**) ---
# Neon Postgres connection string for the bot's own database — deliberately
# separate from the Supabase projects above. Run db/twitch-bot-schema.sql
# against it once before first use.
# Format: postgres://<user>:<password>@<host>/<database>?sslmode=require
TWITCH_BOT_DATABASE_URL=

# Twitch application credentials (from https://dev.twitch.tv/console/apps).
# Used server-side only, to refresh the bot account's access token and to
# look up chatters' avatars via Helix — the client secret never reaches the
# browser. Same values as join-milo-bot's TWITCH_CLIENT_ID/TWITCH_CLIENT_SECRET.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
